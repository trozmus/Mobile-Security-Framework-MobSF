# Environment (determines auth method for MemoryDB)
# local = username/password auth
# dev/prod = IAM authentication
NODE_ENV=local

# Redis/Valkey connection (local development)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=valkey
VALKEY_USERNAME=default
AWS_REGION=us-east-1
MEMORYDB_CLUSTER_NAME=my-cluster-name

# AWS MemoryDB IAM authentication (dev/prod only)
# Worker automatically refreshes IAM tokens (valid 15 min) and restarts on auth errors
# Uncomment these when NODE_ENV=dev or NODE_ENV=prod
# AWS_REGION=us-east-1
# MEMORYDB_CLUSTER_NAME=my-cluster-name
# VALKEY_HOST=clustercfg.my-cluster.xxxxxx.memorydb.us-east-1.amazonaws.com

# BullMQ queue names
QUEUE_INPUT={app-scanner-requests}
QUEUE_OUTPUT={app-scanner-results}
QUEUE_ERRORS={app-scanner-errors}

# MobSF API Key
MOBSF_API_KEY=gt@4^!n@)f0bmug0)jebn&86s8b79a8zf&+6s_$$v7!*hx%*g*1

# PostgreSQL (external)
# For local development (NODE_ENV=local), use password authentication:
API_SCANNER_DB_HOST=localhost
API_SCANNER_DB_PORT=5432
API_SCANNER_DB_USERNAME=postgres
API_SCANNER_DB_PASSWORD=postgres
API_SCANNER_DB_DATABASE=mudita_app_scanner

# For AWS RDS with IAM authentication (NODE_ENV=dev/prod):
# - Uncomment AWS_REGION above
# - Set API_SCANNER_DB_HOST to RDS endpoint (e.g., db.xxx.rds.amazonaws.com)
# - API_SCANNER_DB_PASSWORD is not used (token generated automatically)
# - RDS instance must have IAM authentication enabled
# - IAM role must have rds-db:connect permission
# - Connection lifetime is 10 min (token valid 15 min)
