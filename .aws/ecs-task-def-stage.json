{
  "family": "appstore-stage-mobfscan-task",
  "cpu": "1024",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::216989105762:role/appstore-stage-mobfscan-exec",
  "taskRoleArn": "arn:aws:iam::216989105762:role/appstore-stage-mobfscan-task",
  "containerDefinitions": [
    {
      "name": "appstore-stage-mobfscan",
      "image": "216989105762.dkr.ecr.eu-central-1.amazonaws.com/mudita-appstore-mobfscan:stage",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:8000/queue/health || exit 1"
        ],
        "interval": 60,
        "timeout": 15,
        "retries": 3,
        "startPeriod": 300
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "stage"
        },
        {
          "name": "AWS_REGION",
          "value": "eu-central-1"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "mudita-appstore-stage-db.c5mgoq4uyym5.eu-central-1.rds.amazonaws.com"
        },
        {
          "name": "POSTGRES_DB",
          "value": "mudita_app_store"
        },
        {
          "name": "POSTGRES_PORT",
          "value": "5432"
        },
        {
          "name": "POSTGRES_USER",
          "value": "mudita_app_store"
        },
        {
          "name": "VALKEY_HOST",
          "value": "clustercfg.mudita-appstore-stage-memorydb.b5odpt.memorydb.eu-central-1.amazonaws.com"
        },
        {
          "name": "VALKEY_PORT",
          "value": "6379"
        },
        {
          "name": "VALKEY_USERNAME",
          "value": "mudita-appstore-stage"
        },
        {
          "name": "MEMORYDB_CLUSTER_NAME",
          "value": "mudita-appstore-stage-memorydb"
        },
        {
          "name": "AWS_BUCKET_NAME_PUBLIC",
          "value": "mudita-appstore-storage-stage-public"
        },
        {
          "name": "AWS_BUCKET_NAME_PRIVATE",
          "value": "mudita-appstore-storage-stage-private"
        },
        {
          "name": "MOBSF_PERM_MAPPING_ENABLED",
          "value": "0"
        },
        {
          "name": "MOBSF_DOMAIN_MALWARE_SCAN",
          "value": "0"
        },
        {
          "name": "MOBSF_NIAP_ENABLED",
          "value": "0"
        },
        {
          "name": "MOBSF_DEX2SMALI_ENABLED",
          "value": "0"
        },
        {
          "name": "MOBSF_SO_ANALYSIS_ENABLED",
          "value": "0"
        },
        {
          "name": "BULLMQ_LOCK_DURATION_MS",
          "value": "2700000"
        },
        {
          "name": "BULLMQ_MAX_STALLED_COUNT",
          "value": "0"
        },
        {
          "name": "BULLMQ_STALL_THRESHOLD_S",
          "value": "600"
        },
        {
          "name": "BULLMQ_STALLED_INTERVAL_MS",
          "value": "2700000"
        }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mudita-appstore-stage/appstore-stage-mobfscan",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "compatibilities": [
    "EC2",
    "MANAGED_INSTANCES",
    "FARGATE"
  ],
  "tags": [
    {
      "key": "Project",
      "value": "AppStore"
    },
    {
      "key": "Environment",
      "value": "stage"
    },
    {
      "key": "Terraform",
      "value": "true"
    },
    {
      "key": "Name",
      "value": "appstore-stage-mobfscan-task"
    }
  ]
}
