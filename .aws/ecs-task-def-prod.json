{
  "family": "appstore-prod-mobfscan-task",
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::216989105762:role/appstore-prod-mobfscan-exec",
  "taskRoleArn": "arn:aws:iam::216989105762:role/appstore-prod-mobfscan-task",
  "containerDefinitions": [
    {
      "name": "appstore-prod-mobfscan",
      "image": "216989105762.dkr.ecr.eu-central-1.amazonaws.com/mudita-appstore-mobfscan:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -fsS http://127.0.0.1:8000/login/ || exit 1"
        ],
        "interval": 60,
        "timeout": 15,
        "retries": 3,
        "startPeriod": 300
      },
      "environment": [
        { "name": "NODE_ENV", "value": "prod" },
        { "name": "AWS_REGION", "value": "eu-central-1" },
        { "name": "POSTGRES_HOST", "value": "mudita-appstore-prod-db.c5mgoq4uyym5.eu-central-1.rds.amazonaws.com" },
        { "name": "POSTGRES_DB", "value": "mudita_app_store" },
        { "name": "POSTGRES_PORT", "value": "5432" },
        { "name": "POSTGRES_USER", "value": "mudita_app_store" },
        { "name": "VALKEY_HOST", "value": "clustercfg.mudita-appstore-prod-memorydb.b5odpt.memorydb.eu-central-1.amazonaws.com" },
        { "name": "VALKEY_PORT", "value": "6379" },
        { "name": "VALKEY_USERNAME", "value": "mudita-appstore-prod" },
        { "name": "MEMORYDB_CLUSTER_NAME", "value": "mudita-appstore-prod-memorydb" },
        { "name": "AWS_BUCKET_NAME_PRIVATE", "value": "mudita-appstore-storage-prod-private" },
        { "name": "HOSTNAME", "value": "0.0.0.0" }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mudita-appstore-prod/appstore-prod-mobfscan",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ],
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "compatibilities": ["EC2", "MANAGED_INSTANCES", "FARGATE"],
  "tags": [
    { "key": "Project", "value": "AppStore" },
    { "key": "Environment", "value": "prod" },
    { "key": "Terraform", "value": "true" },
    { "key": "Name", "value": "appstore-prod-mobfscan-task" }
  ]
}
